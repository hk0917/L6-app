<h1>商品一覧</h1>

<p>
  <%= link_to '商品を追加する', new_product_path %> | 
  <%= link_to 'カートを見る', current_cart %>
</p>

<ul>
  <% @products.each do |p| %>
    <li>
      <%= p.name %> (<%= p.price %>円)
      <%= link_to '削除', product_path(p), data: { turbo_method: :delete } %>
      <%= link_to 'カートに追加', new_cart_item_path(product_id: p.id) %>
    </li>
  <% end %>
</ul>