<h1>カートに追加</h1>

<p>商品名称: <%= @product.name %></p>
<p>商品価格: <%= @product.price %>円</p>

<%= form_with model: @cart_item do |f| %>
  <%= f.hidden_field :product_id, value: @product.id %>
  <p>
    <%= f.label :qty, '数量' %><br>
    <%= f.number_field :qty, value: 1, min: 1 %>
  </p>
  <p>
    <%= f.submit 'カートに入れる' %>
  </p>
<% end %>

<%= link_to '戻る', products_path %>